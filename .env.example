# פורט השרת (אופציונלי, ברירת מחדל 3000)
PORT=3000

# כתובת חיבור למסד נתונים Postgres (למשל מ-Neon: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# מפתח סודי להצפנת עוגיות ההתחברות - יש לשנות לערך אקראי וסודי
SESSION_SECRET=change-this-to-a-random-secret-string

# פרטי חשבון המנהל שייווצר אוטומטית בהפעלה הראשונה
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# שליחת מיילים (קוד אימות בהרשמה) - דרך Brevo (https://brevo.com), חינמי
# 1. ליצור חשבון חינמי ב-Brevo
# 2. לאמת כתובת שולח (Sender) - Brevo ישלח מייל אימות עם קישור ללחיצה
# 3. ליצור מפתח API תחת Settings > SMTP & API > API Keys
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM_EMAIL=youraccount@gmail.com

# מזג אוויר בכותרת - דרך OpenWeatherMap (https://openweathermap.org), חינמי
# 1. ליצור חשבון חינמי
# 2. תחת "My API keys" יש מפתח ברירת מחדל (עלול לקחת עד שעה עד שיופעל)
OPENWEATHER_API_KEY=your-openweathermap-api-key

# משתני זמן אזור - חובה כדי שהשעות בלוח יתאימו לשעון ישראל
TZ=Asia/Jerusalem

# התחברות/הרשמה מהירה עם Google - דרך Google Cloud Console, חינמי
# 1. ליצור פרויקט ב-https://console.cloud.google.com
# 2. תחת "APIs & Services" > "OAuth consent screen" להגדיר מסך הסכמה (External, לצרף שם ומייל)
# 3. תחת "Credentials" > "Create Credentials" > "OAuth client ID" מסוג "Web application"
# 4. ב-"Authorized redirect URIs" להוסיף את הכתובת:
#    https://<כתובת-האתר-שלך>/auth/google/callback
#    (וגם http://localhost:3000/auth/google/callback לפיתוח מקומי)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
