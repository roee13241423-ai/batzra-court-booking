# פורט השרת (אופציונלי, ברירת מחדל 3000)
PORT=3000

# כתובת חיבור למסד נתונים Postgres (למשל מ-Neon: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# מפתח סודי להצפנת עוגיות ההתחברות - יש לשנות לערך אקראי וסודי
SESSION_SECRET=change-this-to-a-random-secret-string

# פרטי חשבון המנהל שייווצר אוטומטית בהפעלה הראשונה
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# חשבון Gmail לשליחת מיילים (קוד אימות + אישורי שריון)
# יש ליצור "App Password" בהגדרות האבטחה של חשבון ה-Google (דורש אימות דו-שלבי מופעל):
# https://myaccount.google.com/apppasswords
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
