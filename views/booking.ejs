<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>שריון מגרש - מושב בצרה</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar topbar-centered">
    <div class="user-info">
      <span>שלום, <%= user.firstName %> <%= user.lastName %><% if (user.isAdmin) { %> (מנהל)<% } %></span>
      <% if (user.isAdmin) { %><a href="/admin">ניהול</a><% } %>
      <form method="POST" action="/logout" style="display:inline;">
        <button class="btn small secondary" type="submit">יציאה</button>
      </form>
    </div>
    <h1 class="topbar-title">הזמנת מגרשים - מושב בצרה</h1>
    <div class="topbar-spacer"></div>
  </header>

  <div class="container">
    <div class="court-tabs">
      <% courts.forEach(c => { %>
        <a class="court-tab <%= c.id === court ? 'active' : '' %>" href="/booking?court=<%= c.id %>">מגרש <%= c.name %></a>
      <% }) %>
    </div>

    <div class="card">
      <h2>לוח שריונים - <%= courts.find(c => c.id === court).name %></h2>
      <p class="muted">לחצו על משבצת פנויה כדי לשריין אותה לתאריך ולשעה הספציפיים. השריון הוא חד-פעמי בלבד.</p>

      <div class="week-nav">
        <% if (offset > 0) { %>
          <a class="btn small secondary" href="/booking?offset=<%= offset - 1 %>&court=<%= court %>">&rarr; שבוע קודם</a>
        <% } else { %>
          <span></span>
        <% } %>
        <span class="muted"><%= days[0].label %> - <%= days[6].label %></span>
        <a class="btn small secondary" href="/booking?offset=<%= offset + 1 %>&court=<%= court %>">שבוע הבא &larr;</a>
      </div>

      <div class="legend">
        <span><i style="background:var(--free)"></i> פנוי</span>
        <span><i style="background:var(--mine)"></i> השריון שלי</span>
        <span><i style="background:var(--taken)"></i> תפוס</span>
        <span><i style="background:var(--past)"></i> עבר</span>
      </div>

      <div class="table-scroll">
        <table class="grid">
          <thead>
            <tr>
              <th>שעה</th>
              <% days.forEach(day => { %>
                <th><%= day.dayName %><br><span class="muted"><%= day.label %></span></th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% hours.forEach(hour => { %>
              <tr>
                <th><%= hour %>:00</th>
                <% days.forEach(day => {
                     const cell = grid[day.dateStr][hour];
                %>
                  <td>
                    <% if (cell.taken) { %>
                      <% if (cell.mine) { %>
                        <form method="POST" action="/booking/<%= day.dateStr %>/<%= hour %>/cancel?offset=<%= offset %>&court=<%= court %>">
                          <button type="submit" class="slot mine">שלך (ביטול)</button>
                        </form>
                      <% } else { %>
                        <details class="taken-details" name="taken-contact">
                          <summary class="slot taken">תפוס<br><small><%= cell.ownerName %></small></summary>
                          <div class="contact-card">
                            <strong><%= cell.ownerName %></strong>
                            <% if (cell.ownerPhone) { %><a href="tel:<%= cell.ownerPhone %>">📞 <%= cell.ownerPhone %></a><% } %>
                            <% if (cell.ownerEmail) { %><a href="mailto:<%= cell.ownerEmail %>">✉️ <%= cell.ownerEmail %></a><% } %>
                          </div>
                        </details>
                      <% } %>
                    <% } else if (cell.isPast) { %>
                      <span class="slot past">-</span>
                    <% } else { %>
                      <form method="POST" action="/booking/<%= day.dateStr %>/<%= hour %>?offset=<%= offset %>&court=<%= court %>">
                        <button type="submit" class="slot free">פנוי</button>
                      </form>
                    <% } %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
