<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>שכחתי סיסמה - מגרש מושב בצרה</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container" style="max-width:420px; margin-top:60px;">
    <div class="card">
      <h2>שחזור סיסמה</h2>

      <% if (sent) { %>
        <p class="muted">אם כתובת המייל רשומה אצלנו, נשלח אליה קישור לאיפוס הסיסמה. יש לבדוק גם בתיקיית הספאם.</p>
        <div class="link-row">
          <a href="/login">חזרה להתחברות</a>
        </div>
      <% } else { %>
        <p class="muted">יש להזין את כתובת המייל שנרשמת איתה, ונשלח אליה קישור לאיפוס הסיסמה.</p>
        <% if (error) { %>
          <div class="error"><%= error %></div>
        <% } %>
        <form class="stack" method="POST" action="/forgot-password">
          <label for="email">כתובת מייל</label>
          <input type="email" id="email" name="email" required>

          <div style="margin-top:20px;">
            <button class="btn" type="submit">שליחת קישור לאיפוס</button>
          </div>
        </form>
        <div class="link-row">
          <a href="/login">חזרה להתחברות</a>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
