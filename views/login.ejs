<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>התחברות - מגרש מושב בצרה</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/app.js" defer></script>
</head>
<body>
  <div class="container" style="max-width:420px; margin-top:60px;">
    <div class="card">
      <h2>התחברות</h2>
      <p class="muted">שריון מגרש מושב בצרה</p>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <% if (resetSuccess) { %>
        <div class="error" style="background:#dcfce7; color:#166534;">הסיסמה עודכנה בהצלחה. אפשר להתחבר עם הסיסמה החדשה.</div>
      <% } %>

      <a href="/auth/google" class="btn-google">
        <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z"/>
          <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
          <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
          <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
        </svg>
        <span>המשך עם Google</span>
      </a>

      <div class="auth-divider">או</div>

      <form class="stack" method="POST" action="/login">
        <label for="email">כתובת מייל</label>
        <input type="email" id="email" name="email" required>

        <label for="password">סיסמה</label>
        <div class="password-wrap">
          <input type="password" id="password" name="password" required>
          <button type="button" class="toggle-password" data-toggle-password="password" aria-label="הצג סיסמה">👁️</button>
        </div>

        <div class="checkbox-row">
          <input type="checkbox" id="rememberMe" name="rememberMe">
          <label for="rememberMe">זכור אותי</label>
        </div>

        <div style="margin-top:20px;">
          <button class="btn" type="submit">התחברות</button>
        </div>
      </form>
      <div class="link-row">
        <a href="/forgot-password">שכחתי סיסמה</a>
      </div>
      <div class="link-row">
        עדיין לא נרשמת? <a href="/register">הרשמה</a>
      </div>
    </div>
  </div>
</body>
</html>
