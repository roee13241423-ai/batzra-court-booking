<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>איפוס סיסמה - מגרש מושב בצרה</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/app.js" defer></script>
</head>
<body>
  <div class="container" style="max-width:420px; margin-top:60px;">
    <div class="card">
      <h2>בחירת סיסמה חדשה</h2>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <% if (token) { %>
        <form class="stack" method="POST" action="/reset-password/<%= token %>">
          <label for="password">סיסמה חדשה</label>
          <div class="password-wrap">
            <input type="password" id="password" name="password" minlength="6" required>
            <button type="button" class="toggle-password" data-toggle-password="password" aria-label="הצג סיסמה">👁️</button>
          </div>

          <label for="confirmPassword">אימות סיסמה חדשה</label>
          <div class="password-wrap">
            <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" required>
            <button type="button" class="toggle-password" data-toggle-password="confirmPassword" aria-label="הצג סיסמה">👁️</button>
          </div>

          <div style="margin-top:20px;">
            <button class="btn" type="submit">עדכון סיסמה</button>
          </div>
        </form>
      <% } else { %>
        <div class="link-row">
          <a href="/forgot-password">בקשת קישור חדש</a>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
